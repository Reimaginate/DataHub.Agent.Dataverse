<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Microsoft Dataverse integration agent for Reimaginate DataHub synchronization, merge processing, and Dataverse access.</Description>
		<PackageTags>datahub;dataverse;synchronization;agent</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Requests\Internal\_deprecated\**" />
	  <EmbeddedResource Remove="Requests\Internal\_deprecated\**" />
	  <None Remove="Requests\Internal\_deprecated\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
		<PackageReference Include="FluentValidation" Version="12.2.0" />
		<PackageReference Include="JsonDiffPatch.Net" Version="2.5.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client.Dynamics" Version="1.2.27" />
		<PackageReference Include="Polly" Version="8.8.1" />
		<PackageReference Include="Reimaginate.DataHub.Client" Version="1.4.12" />
		<PackageReference Include="Reimaginate.DataServices" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
		<PackageReference Include="Reimaginate.ProcessingLockService" Version="4.0.0" />
		<PackageReference Include="Reimaginate.ProcessingLockService.Redis" Version="4.0.0" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
	</ItemGroup>

</Project>
